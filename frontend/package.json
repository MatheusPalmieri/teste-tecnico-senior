    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "happy-dom": "^21.0.4",
    "msw": "^2.4.9",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.2",
    "undici": "^8.10.2",
    "vite": "^8.3.6",
